# Public origins used by CORS and the frontend API base.
# Set these to your public Nginx origins in production.
PUBLIC_ORIGIN=http://localhost
ADMIN_ORIGIN=http://localhost:8081

# External PostgreSQL. DATABASE_URL takes precedence when set.
# DATABASE_URL=host=postgres.example.com port=5432 user=postgres password=pureblog dbname=pureblog sslmode=require TimeZone=UTC
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pureblog
POSTGRES_DB=pureblog
POSTGRES_SSLMODE=disable

# Local loopback ports exposed for an external Nginx reverse proxy.
BACKEND_PORT=8080
WEB_PORT=3000
ADMIN_PORT=8081

# Backend secrets / first-run admin seed
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=muxi
ADMIN_PASSWORD=change-me
